<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<HBox xmlns:fx="http://javafx.com/fxml/1" fx:id="root" alignment="CENTER_LEFT" fillHeight="false"
      maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
      xmlns="http://javafx.com/javafx/11.0.14-internal" fx:controller="de.olivergeisel.kegelplay.gui.TeamSummaryController">
    <children>
        <Label fx:id="teamName" alignment="CENTER" contentDisplay="CENTER" maxHeight="1.7976931348623157E308"
               maxWidth="1.7976931348623157E308" text="Label" textAlignment="CENTER" wrapText="true"
               HBox.hgrow="ALWAYS">
            <font>
                <Font name="System Bold" size="28.0"/>
            </font>
            <HBox.margin>
                <Insets right="10.0"/>
            </HBox.margin>
            <padding>
                <Insets right="20.0"/>
            </padding>
        </Label>
        <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
            <children>
                <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
                    <children>
                        <Label text="SP">
                            <font>
                                <Font size="24.0"/>
                            </font>
                            <padding>
                                <Insets right="4.0" top="3.0"/>
                            </padding>
                        </Label>
                        <Label fx:id="totalSetPoints" minWidth="40.0" text="Satzpunke">
                            <font>
                                <Font size="24.0"/>
                            </font>
                            <padding>
                                <Insets right="4.0" top="3.0"/>
                            </padding>
                            <HBox.margin>
                                <Insets right="10.0"/>
                            </HBox.margin>
                        </Label>
                        <Label text="K">
                            <font>
                                <Font size="24.0"/>
                            </font>
                            <padding>
                                <Insets right="4.0" top="3.0"/>
                            </padding>
                        </Label>
                        <Label fx:id="totalPins" minWidth="60.0" text="Ergebnis">
                            <font>
                                <Font size="24.0"/>
                            </font>
                            <padding>
                                <Insets right="4.0" top="3.0"/>
                            </padding>
                        </Label>
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                      nodeOrientation="LEFT_TO_RIGHT" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="P">
                            <font>
                                <Font name="System Bold" size="24.0"/>
                            </font>
                            <padding>
                                <Insets right="4.0" top="3.0"/>
                            </padding>
                        </Label>
                        <Label fx:id="totalTeamPoints" minWidth="20.0" text="Punkte">
                            <font>
                                <Font name="System Bold" size="24.0"/>
                            </font>
                            <padding>
                                <Insets right="4.0" top="3.0"/>
                            </padding>
                        </Label>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>
