<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.lang.*?>
<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:id="grid" alignment="CENTER" maxHeight="1.7976931348623157E308"
          maxWidth="1.7976931348623157E308" minHeight="100.0" minWidth="250.0"
          styleClass="primary-container" xmlns="http://javafx.com/javafx/11.0.14-internal"
          fx:controller="de.olivergeisel.kegelplay.gui.HeaderController">
    <columnConstraints>
        <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="10.0"
                           percentWidth="45.0"/>
        <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="10.0"
                           percentWidth="55.0"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints maxHeight="1.7976931348623157E308" minHeight="10.0" prefHeight="200.0" valignment="CENTER"
                        vgrow="ALWAYS"/>
    </rowConstraints>
    <children>
        <ImageView fx:id="image" pickOnBounds="true" preserveRatio="true" styleClass="border-image"
                   GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.valignment="CENTER"
                   GridPane.vgrow="ALWAYS">
            <GridPane.margin>
                <Insets left="2.0" right="1.0"/>
            </GridPane.margin>
        </ImageView>
        <VBox alignment="CENTER" focusTraversable="true" maxWidth="1.7976931348623157E308"
              nodeOrientation="LEFT_TO_RIGHT" GridPane.columnIndex="1" GridPane.halignment="CENTER"
              GridPane.hgrow="ALWAYS" GridPane.valignment="CENTER" GridPane.vgrow="ALWAYS">
            <children>
                <VBox VBox.vgrow="ALWAYS">
                    <children>
                        <Label fx:id="name" alignment="CENTER" contentDisplay="CENTER" depthTest="ENABLE"
                               lineSpacing="2.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                               minHeight="30.0" minWidth="100.0" style="-fx-pref-width: 95%;" text="Name"
                               textAlignment="CENTER" wrapText="true" VBox.vgrow="ALWAYS">
                            <font>
                                <Font name="Arial Black" size="18.0"/>
                            </font>
                            <styleClass>
                                <String fx:value="centering"/>
                                <String fx:value="primary-complementary-color"/>
                            </styleClass>
                            <padding>
                                <Insets left="3.0" right="3.0"/>
                            </padding>
                        </Label>
                        <Label fx:id="vorname" alignment="CENTER" contentDisplay="CENTER" lineSpacing="2.0"
                               maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="30.0"
                               minWidth="150.0" style="-fx-pref-width: 95%;" text="Vorname" textAlignment="CENTER"
                               wrapText="true" VBox.vgrow="ALWAYS">
                            <font>
                                <Font name="Arial Black" size="18.0"/>
                            </font>
                            <styleClass>
                                <String fx:value="centering"/>
                                <String fx:value="primary-complementary-color"/>
                            </styleClass>
                            <padding>
                                <Insets left="3.0" right="3.0"/>
                            </padding>
                        </Label>
                    </children>
                </VBox>
                <VBox VBox.vgrow="ALWAYS">
                    <children>
                        <Label fx:id="verein" alignment="CENTER" contentDisplay="CENTER" lineSpacing="2.0"
                               maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="30.0"
                               minWidth="150.0" style="-fx-pref-width: 95%;" text="Verein" textAlignment="CENTER"
                               wrapText="true" VBox.vgrow="ALWAYS">
                            <font>
                                <Font name="Arial Black" size="18.0"/>
                            </font>
                            <styleClass>
                                <String fx:value="centering"/>
                                <String fx:value="primary-complementary-color"/>
                            </styleClass>
                            <padding>
                                <Insets bottom="3.0" left="3.0" right="3.0" top="10.0"/>
                            </padding>
                            <VBox.margin>
                                <Insets/>
                            </VBox.margin>
                        </Label>
                    </children>
                </VBox>
            </children>
            <opaqueInsets>
                <Insets left="10.0"/>
            </opaqueInsets>
        </VBox>
    </children>
</GridPane>
