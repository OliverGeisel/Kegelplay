<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox xmlns:fx="http://javafx.com/fxml/1" id="root-pane" fx:id="root" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
      minHeight="700.0" minWidth="1450.0" xmlns="http://javafx.com/javafx/11.0.14-internal">
    <children>
        <HBox fx:id="playerBoxes" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
            <children>
                <fx:include fx:id="pair1" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                            source="player-pair.fxml" HBox.hgrow="ALWAYS"/>
                <fx:include fx:id="pair2" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                            source="player-pair.fxml" HBox.hgrow="ALWAYS"/>
            </children>
            <VBox.margin>
                <Insets/>
            </VBox.margin>
            <padding>
                <Insets right="5.0"/>
            </padding>
        </HBox>
        <VBox fx:id="rounds" alignment="CENTER" fillWidth="false" maxHeight="1.7976931348623157E308"
              maxWidth="1.7976931348623157E308">
            <children>
                <fx:include fx:id="round1" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                            source="round-overview.fxml" VBox.vgrow="ALWAYS"/>
                <fx:include fx:id="round2" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                            source="round-overview.fxml" VBox.vgrow="ALWAYS"/>
                <fx:include fx:id="round3" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                            source="round-overview.fxml" VBox.vgrow="ALWAYS"/>
            </children>
        </VBox>
        <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
            <children>
                <fx:include fx:id="sumHome" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                            source="team-summary.fxml" HBox.hgrow="ALWAYS"/>
                <Label fx:id="difference" alignment="CENTER" contentDisplay="CENTER" minWidth="80.0" snapToPixel="false"
                       text="Label" textAlignment="CENTER" HBox.hgrow="ALWAYS">
                    <font>
                        <Font name="System Bold" size="24.0"/>
                    </font>
                    <HBox.margin>
                        <Insets left="5.0" right="5.0"/>
                    </HBox.margin>
                    <padding>
                        <Insets left="2.0" right="2.0"/>
                    </padding>
                </Label>
                <fx:include fx:id="sumGuest" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                            source="team-summary-reversed.fxml" HBox.hgrow="ALWAYS"/>
            </children>
            <VBox.margin>
                <Insets top="5.0"/>
            </VBox.margin>
        </HBox>

    </children>
</VBox>
